{
  "family": "recaring-rule-base-task",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "taskRoleArn": "arn:aws:iam::757052694924:role/recaringECSTaskRole",
  "executionRoleArn": "arn:aws:iam::757052694924:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "rule-base-worker",
      "image": "757052694924.dkr.ecr.ap-northeast-2.amazonaws.com/recaring-rulebase:latest",
      "essential": true,
      "memory": 256,
      "memoryReservation": 128,
      "environment": [
        { "name": "AWS_REGION",        "value": "ap-northeast-2" },
        { "name": "LOG_LEVEL",         "value": "INFO" },
        { "name": "POLL_WAIT_SECONDS", "value": "20" },
        { "name": "MAX_MESSAGES",      "value": "10" }
      ],
      "secrets": [
        {
          "name": "GPS_QUEUE_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:757052694924:parameter/recaring/AWS_SQS_GPS_QUEUE_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/recaring",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "rule-base"
        }
      }
    }
  ]
}
