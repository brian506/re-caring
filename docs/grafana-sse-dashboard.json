      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "fiscalYearStartMonth": 0,
    "from": "now-15m",
    "hideTimepicker": false,
    "timezone": "browser",
    "to": "now"
  },
  "title": "re-caring SSE 부하테스트",
  "variables": []
